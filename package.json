{
  "name": "skipverse",
  "version": "0.3.3",
  "description": "A from-scratch vector database: HNSW approximate nearest neighbor index, zero runtime dependencies, crash-safe WAL, deterministic replay, and a living search visualization.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "bin": {
    "skipverse": "./dist/node/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test \"test/*.test.ts\"",
    "demo:build": "node demo/build.mjs",
    "serve": "tsx src/node/cli.ts serve",
    "example": "tsx examples/quickstart.ts",
    "bench": "tsx bench/bench.ts",
    "bench:ci": "tsx bench/bench.ts --small --assert",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "vector-database",
    "hnsw",
    "ann",
    "nearest-neighbor",
    "embeddings",
    "similarity-search",
    "from-scratch",
    "zero-dependency"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
