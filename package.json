{
  "name": "skipverse",
  "version": "0.4.0",
  "description": "A from-scratch vector database: HNSW approximate nearest neighbor index, zero runtime dependencies, crash-safe WAL, deterministic replay, and a living search visualization.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiyuhuating/skipverse.git"
  },
  "homepage": "https://github.com/qiyuhuating/skipverse#readme",
  "bugs": {
    "url": "https://github.com/qiyuhuating/skipverse/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/node/index.js",
  "types": "./dist/node/index.d.ts",
  "bin": {
    "skipverse": "./dist/node/cli.js"
  },
  "files": [
    "dist",
    "demo/index.html",
    "demo/bundle.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsx --test \"test/*.test.ts\"",
    "demo:build": "node demo/build.mjs",
    "serve": "tsx src/node/cli.ts serve",
    "example": "tsx examples/quickstart.ts",
    "bench": "tsx bench/bench.ts",
    "bench:ci": "tsx bench/bench.ts --small --assert",
    "prepack": "npm run build && npm run demo:build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "vector-database",
    "hnsw",
    "ann",
    "nearest-neighbor",
    "embeddings",
    "similarity-search",
    "from-scratch",
    "zero-dependency"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
